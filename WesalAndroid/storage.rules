rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['fxKvKnbnksPqZy07rQjTzxIKzzP2', 'D6Z812za9ZNUW0kAt7SaFD3a9UN2'] ||
        (request.auth.token.email != null &&
         request.auth.token.email.lower() in ['eslamfifty40@gmail.com', 'tbtbttbbt7@gmail.com'])
      );
    }

    function underMaxSize() {
      return request.resource != null && request.resource.size <= 50 * 1024 * 1024;
    }

    function isImageOrBinaryUnder10Mb() {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (request.resource.contentType == null ||
         request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/octet-stream');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImageOrBinaryUnder10Mb();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /frame_library/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() && isImageOrBinaryUnder10Mb();
      allow delete: if isSuperAdmin();
    }

    match /official_team/{fileName} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() && isImageOrBinaryUnder10Mb();
    }

    match /subscription_ids/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImageOrBinaryUnder10Mb();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /support_attachments/{ticketId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSuperAdmin();
    }

    match /group_avatars/{groupId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isImageOrBinaryUnder10Mb();
      allow delete: if isSignedIn();
    }

    match /stories_media/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && underMaxSize();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /chat_media/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    // Actual chat-media upload paths used by the app (ChatRepositoryImpl.sendMediaMessage
    // writes to "<folder>/{chatId}/{messageId}<ext>"). These prefixes were missing, so every
    // video/document upload fell through to default-deny and always failed, and images only
    // survived via a base64 fallback. Participant-level checks cannot be done from Storage
    // rules here (the app uses a named, non-default Firestore database, which cross-service
    // firestore.get() from Storage rules cannot read), so these blocks deliberately mirror
    // the existing chat_media/voice_notes/shared_files style: signed-in users + size cap.
    match /images/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /videos/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /voices/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /audios/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /documents/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    // Story audio uploads (StoryRepositoryImpl writes "stories_audio/{uid}/{storyId}.m4a");
    // mirrors stories_media: the uploader's own uid is part of the path and is enforced.
    match /stories_audio/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && underMaxSize();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Shared chat wallpaper (ChatRepositoryImpl writes "chat_wallpapers/{chatId}.jpg").
    match /chat_wallpapers/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isImageOrBinaryUnder10Mb();
      allow delete: if isSignedIn();
    }

    match /voice_notes/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /shared_files/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /channel_media/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }
  }
}
