rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function underMaxSize() {
      return request.resource != null && request.resource.size <= 50 * 1024 * 1024;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
        request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /frame_library/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.auth.token.email in ['eslamfifty40@gmail.com', 'tbtbttbbt7@gmail.com'] &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.token.email in ['eslamfifty40@gmail.com', 'tbtbttbbt7@gmail.com'];
    }

    match /group_avatars/{groupId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    match /stories_media/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && underMaxSize();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /chat_media/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /voice_notes/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /shared_files/{chatId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }

    match /channel_media/{channelId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && underMaxSize();
      allow delete: if isSignedIn();
    }
  }
}
