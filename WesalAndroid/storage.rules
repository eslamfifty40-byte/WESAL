rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function underMaxSize() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /group_avatars/{groupId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /stories_media/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && underMaxSize();
    }

    match /chat_media/{chatId}/{fileName} {
      allow read, write: if isSignedIn() && underMaxSize();
    }

    match /voice_notes/{chatId}/{fileName} {
      allow read, write: if isSignedIn() && underMaxSize();
    }

    match /shared_files/{chatId}/{fileName} {
      allow read, write: if isSignedIn() && underMaxSize();
    }
  }
}
