<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wesal" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/wesal_black</item>
        <item name="android:navigationBarColor">@color/wesal_black</item>
        <!-- Branded gradient (deep dark teal/navy → app background) instead of flat
             #06090B black: the starting window and any pre-first-frame moment now show
             the app's own brand surface rather than a dead black screen. -->
        <item name="android:windowBackground">@drawable/wesal_window_background</item>
    </style>

    <style name="Theme.Wesal.Splash" parent="Theme.SplashScreen">
        <!-- Splash background accepts a colour only; wesal_splash_bg is the brand teal
             tone of the window gradient, so the splash frame is no longer flat black. -->
        <item name="windowSplashScreenBackground">@color/wesal_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@drawable/wesal_window_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Wesal</item>
    </style>
</resources>
