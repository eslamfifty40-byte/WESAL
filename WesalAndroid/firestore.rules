rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        request.auth.uid in ['fxKvKnbnksPqZy07rQjTzxIKzzP2', 'D6Z812za9ZNUW0kAt7SaFD3a9UN2'] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in ['eslamfifty40@gmail.com', 'tbtbttbbt7@gmail.com'])
      );
    }

    function isActiveModerator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.active == true;
    }

    function hasModPermission(permKey) {
      return isSuperAdmin() || (
        isActiveModerator() &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data[permKey] == true
      );
    }

    function isProtectedAdminTarget(uid) {
      return uid in ['fxKvKnbnksPqZy07rQjTzxIKzzP2', 'D6Z812za9ZNUW0kAt7SaFD3a9UN2'];
    }

    function isAdminOrMod() {
      return isSuperAdmin() || isActiveModerator();
    }

    function areContactsAccepted(uidA, uidB) {
      let idForward = uidA + '_' + uidB;
      let idReverse = uidB + '_' + uidA;
      return (
        (exists(/databases/$(database)/documents/contact_requests/$(idForward)) &&
         get(/databases/$(database)/documents/contact_requests/$(idForward)).data.status == 'ACCEPTED') ||
        (exists(/databases/$(database)/documents/contact_requests/$(idReverse)) &&
         get(/databases/$(database)/documents/contact_requests/$(idReverse)).data.status == 'ACCEPTED')
      );
    }

    // Spec §10.3 — server-side ban enforcement.
    // A ban used to be client-only: a banned user with a modified client (or raw API
    // access) could keep reading/writing everything. This helper makes the ban bite in
    // rules for the social surfaces (chats/messages/groups/stories/calls below).
    // Safety properties (round-3 hardening — the gate may only bite on a ban that is
    // POSITIVELY established, because a stale or mis-typed flag on an old doc
    // otherwise locks a legitimate user out of every gated surface at once; that is
    // exactly what locked the owner (10002) out of sending and calling):
    //  - Field or user doc absent  => NOT banned (legitimate users are never locked out
    //    by a missing field; older docs predate the ban fields).
    //  - isBanned == true alone is NOT enough. The ban counts as active only when
    //    banType says PERMANENT, or banExpiresAt is actually stored as a number and
    //    still lies in the future. A banExpiresAt stored as a Timestamp/String (old
    //    AI-Studio-era docs) or a missing expiry therefore never denies on its own —
    //    and the `is number` guard means the ordering comparison can never raise an
    //    evaluation error (which Firestore would surface as a blanket deny).
    //  - Super admins are exempt (the client already forbids banning protected admins;
    //    this keeps moderation working even if a doc were mis-flagged). The exemption
    //    also covers the two owner accounts by their user doc's numericId
    //    (10001/10002, matching the client's Constants.ADMIN_NUMERIC_IDS): the
    //    rules-level super-admin definition above (super_admins doc / uid / email)
    //    does not always cover them, and a stale flag on an owner doc must never be
    //    able to lock the owners out of their own app.
    //  - Active moderators are exempt too (round-2 fix): the staff system already
    //    forbids banning them in the client, and without this exemption a stale
    //    isBanned flag on a moderator doc silently killed every moderated surface
    //    (chats/calls) while their admin panel kept working.
    //  - The users collection itself is NOT gated by this helper, so a banned user can
    //    still read their own doc and see their ban status/reason in the client.
    // Round-4 (§10.3 closure): revocation/claims are now handled by the
    // setUserBanState callable in firebase/functions — on ban it stamps a
    // `banned` custom claim and revokes the target's refresh tokens, on unban it
    // strips the claim. The gate below therefore ALSO consults the token claim:
    // a token refreshed after the ban is stopped by the claim arm even where a
    // surface might not re-read the user doc. The claim arm applies the SAME
    // positive-ban test as the doc arm (PERMANENT, or a numeric banExpiresAt
    // still in the future), so a TEMPORARY ban expires at the claim layer too
    // rather than blocking until a manual unban. Residual platform limit: an ID
    // token issued BEFORE the ban carries no claim and stays valid until it
    // refreshes (<= ~1 h) — the doc arm above covers every gated surface in the
    // meantime.
    function isNumericIdSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('numericId', 0) in [10001, 10002, '10001', '10002'];
    }

    function isCurrentlyBanned() {
      return isSignedIn() &&
        !isSuperAdmin() &&
        !isNumericIdSuperAdmin() &&
        !isActiveModerator() &&
        (
          // §10.3 claim arm (round 4): the ban custom claims stamped by the
          // setUserBanState function (`banned` / `banType` / `banExpiresAt`,
          // the latter stamped as a Number of epoch milliseconds — the same
          // units the doc arm below compares against request.time.toMillis()).
          // This arm MIRRORS the doc arm's positive-ban semantics exactly
          // (REVIEW_R4_PASS2 M1): the claim counts only while the ban is
          // actually active — banType is PERMANENT, or a numeric expiry still
          // lies in the future — so a TEMPORARY ban stops blocking at expiry
          // instead of lasting until a manual unban strips the claim.
          // `.get(key, default)` everywhere means a token with no claims
          // (every token issued before the ban, and every legitimate user's
          // token) evaluates to false here, and the `is number` guard means a
          // missing or mistyped expiry can never error the gate — absent or
          // malformed claims are simply NOT banned via this arm.
          (
            request.auth.token.get('banned', false) == true &&
            (
              request.auth.token.get('banType', '') == 'PERMANENT' ||
              (
                request.auth.token.get('banExpiresAt', 0) is number &&
                request.auth.token.get('banExpiresAt', 0) > request.time.toMillis()
              )
            )
          ) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banType', '') == 'PERMANENT' ||
              (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banExpiresAt', 0) is number &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banExpiresAt', 0) > request.time.toMillis()
              )
            )
          )
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }

    // Spec §12.5 (round 4): membership ADDITIONS are server-side only. The
    // changeGroupMembership callable (firebase/functions, Admin SDK — bypasses
    // rules) verifies each candidate's groupAddPrivacy before adding them, which
    // rules cannot express (no iteration over a memberIds diff). A direct client
    // update may therefore only ADD:
    //   - nobody (pure removals / unrelated field updates), or
    //   - the caller themself (self-join via an OPEN/INVITE_ONLY invite — the
    //     joiner consents for themself; the outer update arms still decide who
    //     may write the group doc at all), or
    //   - exactly one user holding a PENDING join request, when the caller is a
    //     group admin approving it (the requester consented by asking to join;
    //     approveGroupJoinRequest adds one requester per write).
    // Any other added uid denies the update. Removals are never restricted here.
    function groupMemberAdditionsAllowed(groupId) {
      let added = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      return added.size() == 0 ||
        added.hasOnly([request.auth.uid]) ||
        (
          isGroupAdmin(groupId) &&
          added.size() == 1 &&
          exists(/databases/$(database)/documents/groups/$(groupId)/join_requests/$(added[0])) &&
          get(/databases/$(database)/documents/groups/$(groupId)/join_requests/$(added[0])).data.get('status', '') == 'PENDING'
        );
    }

    function channelData(channelId) {
      return get(/databases/$(database)/documents/channels/$(channelId)).data;
    }

    function isChannelManager(channelId) {
      let data = channelData(channelId);
      return isSignedIn() && (
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.moderatorIds
      );
    }

    function canReadChannelPosts(channelId) {
      let data = channelData(channelId);
      return isSignedIn() && (
        data.isPublic == true ||
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.moderatorIds ||
        request.auth.uid in data.subscriberIds
      );
    }

    // Super Admin registry
    match /super_admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Delegated Moderators
    match /moderators/{modUid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canManageAdmins');
    }

    // Global Appearance & Welcome Configuration
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canCustomizeGlobalTheme') || hasModPermission('canBroadcastAnnouncements');
    }

    // Frame / icon library managed from the admin panel (read: everyone signed in, write: admins/authorized mods)
    match /frame_library/{frameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasModPermission('canManageLibrary') || hasModPermission('canManageFramesAndNeon');
    }

    // Verification & Subscription Requests
    match /subscription_requests/{reqId} {
      allow read: if hasModPermission('canManageVerification') || hasModPermission('canManageFramesAndNeon') || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if hasModPermission('canManageVerification') || hasModPermission('canManageFramesAndNeon');
    }

    // Verification & Admin & Hidden Audit Logs
    match /verification_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /hidden_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /official_announcements/{annId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canBroadcastAnnouncements');
    }

    match /banned_identifiers/{idHash} {
      // Round-4 §10.2 (P2-13): reads split get/list. Every client read of this
      // collection is a single-doc get by exact identifier-hash doc id (the
      // sign-in / sign-up / phone-change ban checks in AuthRepositoryImpl and
      // UserRepositoryImpl) — those keep working unchanged for any signed-in
      // user. Listing/querying the whole collection (which would enumerate
      // every banned email/phone hash, target uid and reason) is admin/mod
      // only. No client flow lists this collection (verified by grep).
      allow get: if isSignedIn();
      allow list: if isAdminOrMod();
      allow create, update, delete: if hasModPermission('canManageUsersModeration');
    }

    match /wesal_id_index/{numId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || hasModPermission('canManageUsersModeration') || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /phone_uniqueness/{pHash} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /phone_verifications/{phoneHash} {
      // Phone OTP state (hashed codes, expiry, attempt budget), owned
      // exclusively by the sendPhoneCode / verifyPhoneCode /
      // verifyPhoneCodeForCurrentUser callables running on the Admin SDK,
      // which bypasses rules. Clients must never read or write here: a read
      // would leak live verification state, and a write could forge one.
      allow read, write: if false;
    }

    // Round-2 §9.4/9.5: moderator writes to a user doc are FIELD-SCOPED. A write is
    // allowed only when EVERY changed key belongs to the field set of at least one
    // permission the moderator actually holds. The sets mirror exactly what the
    // client moderator flows write (UserRepositoryImpl: verification grant/revoke,
    // setAccountFrame/setAccountIcon/setAccountNeonStyle/setAccountNameplateColor,
    // banUser/warnUser/setAccountHiddenFromSearch/adminDeleteUser soft path, and
    // the setGlobalCustomerDefaults batch for theme-delegated moderators).
    // Previously ANY active moderator could rewrite ANY field of any
    // non-protected user document.
    function moderatorUserUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        (hasModPermission('canManageVerification') && changed.hasOnly([
          'isVerified', 'verifiedByUid', 'verifiedAt', 'verificationNote',
          'verificationType', 'verificationGlowColor', 'verificationGlowEnabled',
          'verificationGlowIntensity', 'verificationExpiresAt'
        ])) ||
        ((hasModPermission('canManageFramesAndNeon') || hasModPermission('canCustomizeGlobalTheme')) && changed.hasOnly([
          'frameId', 'frameUrl', 'frameExpiresAt', 'grantedFrameIds',
          'iconId', 'iconUrl',
          'neonEnabled', 'neonColor', 'neonGlowIntensity', 'nameplateColor'
        ])) ||
        (hasModPermission('canManageUsersModeration') && changed.hasOnly([
          'isBanned', 'banType', 'banReason', 'banExpiresAt', 'warningsCount',
          'hiddenFromSearch', 'hideFromSearchReason', 'hiddenAt', 'hiddenByUid',
          'deletedAt', 'deletedPermanent', 'isOnline'
        ]))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        !('isVerified' in request.resource.data && request.resource.data.isVerified == true) &&
        !('verifiedByUid' in request.resource.data && request.resource.data.verifiedByUid != '') &&
        !('deletedPermanent' in request.resource.data && request.resource.data.deletedPermanent == true) &&
        !('isBanned' in request.resource.data && request.resource.data.isBanned == true) &&
        // Review fix (round-3 pass 1): a fresh doc may never claim an owner admin
        // numericId (10001/10002). isCurrentlyBanned() exempts those ids via
        // isNumericIdSuperAdmin(), so an unguarded create/update would let any
        // user make themselves permanently ban-proof. Legit skeletons are
        // created WITHOUT numericId (allocation is a follow-up merge write),
        // and the genuine owners' repair writes go through isSuperAdmin().
        !('numericId' in request.resource.data && request.resource.data.numericId in [10001, 10002, '10001', '10002']);
      allow update: if (
        isOwner(userId) &&
        (
          isSuperAdmin() ||
          (
            // The owner may not touch any admin-managed field. grantedFrameIds is
            // protected outright: only admin/mod grant flows may extend it. The
            // referral attribution fields (referredByUid/referredByNumericId) are
            // handled by the dedicated carve-out below: the one-time registration
            // stamp (an owner merge-update on the just-created doc) may set them
            // ONLY while they are still empty; once set they are locked.
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isVerified',
              'verifiedByUid',
              'verifiedAt',
              'verificationNote',
              'verificationType',
              'verificationGlowColor',
              'verificationGlowEnabled',
              'verificationGlowIntensity',
              'verificationExpiresAt',
              'frameUrl',
              'neonEnabled',
              'neonColor',
              'neonGlowIntensity',
              'adminPermissions',
              'isBanned',
              'banType',
              'banReason',
              'banExpiresAt',
              'warningsCount',
              'hiddenFromSearch',
              'hideFromSearchReason',
              'hiddenAt',
              'hiddenByUid',
              'grantedFrameIds'
            ]) &&
            // Frame self-pick carve-out (round 2): frameId/frameExpiresAt are NOT
            // in the protected list above; instead the owner may change them ONLY
            // to clear the frame, or to (re)apply a frame an admin granted them
            // (present in the doc's grantedFrameIds), or to keep the frame already
            // worn (legacy grants predate the list). Any other frame stays
            // admin-only, exactly like the client-side setOwnFrame() check.
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['frameId', 'frameExpiresAt']) ||
              request.resource.data.get('frameId', '') == '' ||
              request.resource.data.get('frameId', '') in resource.data.get('grantedFrameIds', []) ||
              request.resource.data.get('frameId', '') == resource.data.get('frameId', '') ||
              // The built-in all-customers default frame id: it is BY DESIGN the
              // frame every customer may wear (and the client reader's fallback
              // when the config doc was never written), so wearing it is never
              // a self-grant of a restricted frame.
              request.resource.data.get('frameId', '') == 'all_customers' ||
              // Review fix (round-2 pass 1): completeUserProfile() stamps the
              // admin-configured GLOBAL default frame into the same owner update
              // when the worn frame is blank. That default is neither granted
              // nor previously worn, so without this arm the whole profile
              // update was denied for blank-frame users. The arm only ever
              // allows the exact configured default (never an arbitrary frame)
              // and only while the global toggle is enabled in the config doc
              // the admin panel writes.
              (
                exists(/databases/$(database)/documents/system_config/global_appearance) &&
                get(/databases/$(database)/documents/system_config/global_appearance).data.get('globalCustomerFrameEnabled', false) == true &&
                (
                  request.resource.data.get('frameId', '') == get(/databases/$(database)/documents/system_config/global_appearance).data.get('defaultCustomerFrameId', '') ||
                  request.resource.data.get('frameId', '') == get(/databases/$(database)/documents/system_config/global_appearance).data.get('defaultFrameId', '')
                )
              )
            ) &&
            // Referral stamp carve-out (round-3 review fix): the client stamps
            // referredByUid/referredByNumericId AFTER the skeleton create, as a
            // fire-and-forget owner merge-update (AuthRepositoryImpl), so a blanket
            // protected-keys ban on those fields denied the stamp itself and the
            // whole referral feature silently failed once these rules deployed.
            // This arm allows the owner to touch those keys ONLY while the stored
            // values are still empty/zero — i.e. exactly the one-time stamp; once
            // set, any further owner change to them is denied (attribution can
            // never be re-pointed by the account owner).
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referredByUid', 'referredByNumericId']) ||
              (resource.data.get('referredByUid', '') == '' && resource.data.get('referredByNumericId', 0) == 0)
            ) &&
            // Review fix (round-3 pass 1): numericId is deliberately NOT in the
            // protected list above — the sign-in flow legitimately (re)assigns it
            // on the owner's own doc (blank/invalid -> random candidate). But in
            // this non-super-admin arm it may never be CHANGED TO an owner admin
            // id (10001/10002): isNumericIdSuperAdmin() would then exempt the
            // account from the isCurrentlyBanned() gate forever, letting any
            // banned user make themselves ban-proof with a one-field self-write.
            // The genuine owners are covered by the isSuperAdmin() arm above
            // (the Constants admin emails are exactly the rules-level
            // super-admin emails), so their numericId repair writes are
            // unaffected. Unchanged values are not in affectedKeys and always
            // pass; changes to any non-admin value always pass.
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['numericId']) ||
              !(request.resource.data.get('numericId', '') in [10001, 10002, '10001', '10002'])
            )
          )
        )
      ) || (
        isSuperAdmin()
      ) || (
        !isProtectedAdminTarget(userId) &&
        isActiveModerator() &&
        moderatorUserUpdateAllowed()
      );
      allow delete: if isSuperAdmin() && !isProtectedAdminTarget(userId);

      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /private/{docId} {
        allow read, write, delete: if isOwner(userId) || isSuperAdmin() || hasModPermission('canInspectPrivateData');
      }

      // Profile visitors (Sec 23) — STAGED by audit B14 (2026-11-27), NOT YET
      // DEPLOYED: until this file is deployed the subcollection has no match
      // and is deny-by-default, so recordProfileVisit() writes fail silently
      // (swallowed by runCatching) and observeProfileVisitors() maps the
      // listener error to an empty list — the feature shows 0 visits forever.
      // Shape mirrors the client exactly: the doc id IS the visitor's uid
      // (recordProfileVisit writes document(myUid) with visitorUid == myUid),
      // the profile owner reads and clears (batch-deletes) their own list,
      // and a visitor may create/update ONLY their own visitor doc. Nobody
      // can read another user's visitors.
      match /profile_visitors/{visitorId} {
        allow read: if isOwner(userId);
        allow create, update: if isSignedIn() && !isCurrentlyBanned() &&
          visitorId == request.auth.uid &&
          request.resource.data.visitorUid == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    // Deleted-account tombstones (spec §10.2): deleteAccountPermanently() writes one
    // doc per permanently deleted account (uid, numericId, publicId, deletedBy,
    // deletedAt, reason) so a deletion stays auditable after the user doc is gone.
    // The client write happens in the deleting admin's auth context (super admin —
    // the repository flow is super-admin-only), so create mirrors that; moderators
    // with user-moderation permission may also create/read for their flows.
    // Tombstones are immutable for everyone except the super admin.
    match /deleted_accounts/{docId} {
      allow read: if isSuperAdmin() || hasModPermission('canManageUsersModeration');
      allow create: if isSuperAdmin() || hasModPermission('canManageUsersModeration');
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Contact Requests & Friendship Gating
    // Round-4 §10.1: the ban gate now covers this block too (read/create/update,
    // mirroring chats/groups; delete stays ungated like the other gated blocks).
    // The areContactsAccepted() helper reads these docs via get(), which is not
    // subject to this read rule, so gating reads cannot break chat creation.
    match /contact_requests/{requestId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }

    // Chats & E2EE Messages (direct chat creation requires ACCEPTED contact request; official WESAL & support chats allowed)
    match /chats/{chatId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && (
        request.auth.uid in resource.data.participantIds ||
        chatId == ('wesal_official_' + request.auth.uid) ||
        isAdminOrMod()
      );
      allow create: if isSignedIn() && !isCurrentlyBanned() && (
        (
          chatId == ('wesal_official_' + request.auth.uid) &&
          request.resource.data.isOfficialWesalChat == true &&
          request.auth.uid in request.resource.data.participantIds
        ) ||
        isAdminOrMod() ||
        (
          request.auth.uid in request.resource.data.participantIds && (
            request.resource.data.isGroup == true ||
            request.resource.data.isSupportChat == true ||
            (
              request.resource.data.participantIds.size() == 2 &&
              areContactsAccepted(
                request.resource.data.participantIds[0],
                request.resource.data.participantIds[1]
              )
            )
          )
        )
      );
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        request.auth.uid in resource.data.participantIds ||
        chatId == ('wesal_official_' + request.auth.uid) ||
        isAdminOrMod()
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if !isCurrentlyBanned() && (isChatParticipant(chatId) ||
          chatId == ('wesal_official_' + request.auth.uid) ||
          isAdminOrMod());
        allow create: if isSignedIn() && !isCurrentlyBanned() && (
          (isChatParticipant(chatId) && request.resource.data.senderId == request.auth.uid) ||
          (
            request.resource.data.senderId in ['WESAL_SYSTEM', 'wesal_system'] &&
            chatId.matches('wesal_official_.*') &&
            (chatId == ('wesal_official_' + request.auth.uid) || isAdminOrMod())
          )
        );
        allow update: if !isCurrentlyBanned() && isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedForUsers'])
        );
        allow delete: if isSuperAdmin();
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.adminIds &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if !isCurrentlyBanned() && groupMemberAdditionsAllowed(groupId) && (isGroupAdmin(groupId) || (
        isSignedIn() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'adminIds']) &&
        resource.data.memberIds.removeAll([request.auth.uid]) == request.resource.data.memberIds &&
        resource.data.adminIds.removeAll([request.auth.uid]) == request.resource.data.adminIds
      ));
      // Group delete — STAGED by audit R5 (2026-11-27), NOT YET DEPLOYED:
      // was `allow delete: if false`, which made the new creator-only
      // deleteGroup() client path impossible. Creator-only, mirroring the
      // repository require. The linked grp_ chat doc is hidden for all
      // members client-side via deletedForUsers (chat delete stays
      // super-admin-only; participant update is already allowed).
      allow delete: if isSignedIn() && !isCurrentlyBanned() && resource.data.creatorId == request.auth.uid;

      // Group join requests — STAGED by audit R5 (2026-11-27), NOT YET
      // DEPLOYED: this subcollection previously had NO match at all
      // (deny-by-default), so APPROVAL_REQUIRED join requests could not be
      // written or read by clients. Shape mirrors the client exactly: the
      // doc id IS the requester's uid (requestJoinGroup writes
      // document(uid) with requesterUid == uid, status PENDING); group
      // admins read/approve/reject; the requester reads/cancels their own.
      match /join_requests/{requestId} {
        allow read: if !isCurrentlyBanned() && (isGroupAdmin(groupId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        ));
        allow create: if isSignedIn() && !isCurrentlyBanned() &&
          requestId == request.auth.uid &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'PENDING';
        allow update: if !isCurrentlyBanned() && isGroupAdmin(groupId);
        allow delete: if isGroupAdmin(groupId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        );
      }
    }

    // Broadcast Channels (Public & Private)
    // Round-4 §10.1: ban gate extended to this block and its posts/comments/
    // join_requests subcollections (read/create/update, mirroring chats/groups;
    // deletes keep their existing conditions, as in the other gated blocks).
    match /channels/{channelId} {
      allow read: if isSignedIn() && !isCurrentlyBanned();
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.subscriberIds;
      // Round-11 (item 9) SECURITY FIX: the two self-service arms below
      // previously restricted only WHICH FIELDS changed, not WHOSE entries
      // changed — any signed-in user could rewrite a public channel's whole
      // subscriberIds list (arm 2), and any subscriber could rewrite
      // moderatorIds and thereby appoint THEMSELF moderator (arm 3), then
      // use the manager arm for full channel control. Both arms are now
      // SELF-ONLY (mirrors ModerationLogic.isSelfOnlyMembershipChange in
      // the client): subscriber additions/removals may name only the
      // caller, and moderatorIds may only ever LOSE the caller themself
      // (leaving gives up the seat) — appointments stay owner-only (arm 1).
      allow update: if !isCurrentlyBanned() && (isAdminOrMod() || (
        isSignedIn() && (
          (
            (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.moderatorIds) &&
            request.resource.data.ownerUid == resource.data.ownerUid
          ) || (
            resource.data.isPublic == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberIds', 'subscribersCount']) &&
            request.resource.data.subscriberIds.removeAll(resource.data.subscriberIds).hasOnly([request.auth.uid]) &&
            resource.data.subscriberIds.removeAll(request.resource.data.subscriberIds).hasOnly([request.auth.uid])
          ) || (
            request.auth.uid in resource.data.subscriberIds &&
            request.auth.uid != resource.data.ownerUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberIds', 'moderatorIds', 'subscribersCount']) &&
            request.resource.data.subscriberIds.removeAll(resource.data.subscriberIds).hasOnly([request.auth.uid]) &&
            resource.data.subscriberIds.removeAll(request.resource.data.subscriberIds).hasOnly([request.auth.uid]) &&
            request.resource.data.moderatorIds.removeAll(resource.data.moderatorIds).size() == 0 &&
            resource.data.moderatorIds.removeAll(request.resource.data.moderatorIds).hasOnly([request.auth.uid])
          )
        )
      ));
      allow delete: if isAdminOrMod() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /posts/{postId} {
        allow read: if !isCurrentlyBanned() && canReadChannelPosts(channelId);
        allow create: if !isCurrentlyBanned() && isChannelManager(channelId) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if !isCurrentlyBanned() && (isChannelManager(channelId) || (
          canReadChannelPosts(channelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts', 'userReactions', 'commentsCount'])
        ));
        allow delete: if isChannelManager(channelId);

        match /comments/{commentId} {
          allow read: if !isCurrentlyBanned() && canReadChannelPosts(channelId);
          allow create: if !isCurrentlyBanned() && canReadChannelPosts(channelId) &&
            request.resource.data.authorUid == request.auth.uid;
          allow delete: if isChannelManager(channelId) || (
            isSignedIn() && resource.data.authorUid == request.auth.uid
          );
          allow update: if false;
        }
      }

      match /join_requests/{requestId} {
        allow read: if !isCurrentlyBanned() && (isChannelManager(channelId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        ));
        allow create: if isSignedIn() && !isCurrentlyBanned() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'PENDING';
        allow update: if !isCurrentlyBanned() && isChannelManager(channelId);
        allow delete: if isChannelManager(channelId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        );
      }
    }

    // Stories (24h TTL enforced in query & client)
    match /stories/{storyId} {
      allow read: if isSignedIn() && !isCurrentlyBanned();
      allow create: if isSignedIn() && !isCurrentlyBanned() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds'])
      );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /viewers/{viewerId} {
        // Round-4 §10.1: viewer writes (and reads) join the ban gate — a banned
        // user must not be able to register story views.
        allow read: if isSignedIn() && !isCurrentlyBanned();
        allow create: if isSignedIn() && !isCurrentlyBanned() &&
          request.auth.uid == viewerId &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid != request.auth.uid &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // WebRTC Calls Signaling
    match /calls/{callId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.callerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read, create: if isSignedIn() && !isCurrentlyBanned() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }

    // Abuse Reports
    // Deliberately NOT ban-gated (§10.1): a banned user must still be able to
    // file a report/appeal — gating create here would remove their only
    // recourse channel.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if isSuperAdmin() || hasModPermission('canManageReports');
      allow delete: if false;
    }

    // Contact Label Lists
    match /contact_lists/{listId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Events & RSVPs
    // Round-4 §10.1: ban gate extended here (read/create/update; delete keeps
    // its existing creator/admin condition, as in the other gated blocks).
    match /events/{eventId} {
      allow read: if isSignedIn() && !isCurrentlyBanned();
      allow create: if isSignedIn() && !isCurrentlyBanned() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.creatorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids'])
      );
      allow delete: if isAdminOrMod() || (isSignedIn() && resource.data.creatorUid == request.auth.uid);
    }

    // Scheduled Calls
    // Round-4 §10.1: ban gate extended here. The previously combined
    // update+delete line is split so delete keeps its exact old condition
    // (ungated, mirroring the other gated blocks) while update is gated.
    match /scheduled_calls/{scheduleId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.participants
      );
    }

    // Support Tickets & Replies
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdminOrMod());
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAdminOrMod() || (
        isSignedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.userUid == resource.data.userUid
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isAdminOrMod() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          (
            isAdminOrMod() ||
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userUid == request.auth.uid
          );
        allow update, delete: if isSuperAdmin();
      }
    }

    // Broadcast Lists (distinct from Groups; sender-only)
    // Round-4 §10.1: ban gate extended here. The previously combined
    // read+update+delete line is split so delete keeps its exact old
    // condition (ungated, mirroring the other gated blocks).
    match /broadcast_lists/{listId} {
      allow read, update: if isSignedIn() && !isCurrentlyBanned() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && !isCurrentlyBanned() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
