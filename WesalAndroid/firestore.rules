rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        request.auth.uid in ['fxKvKnbnksPqZy07rQjTzxIKzzP2', 'D6Z812za9ZNUW0kAt7SaFD3a9UN2'] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in ['eslamfifty40@gmail.com', 'tbtbttbbt7@gmail.com'])
      );
    }

    function isActiveModerator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.active == true;
    }

    function hasModPermission(permKey) {
      return isSuperAdmin() || (
        isActiveModerator() &&
        get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data[permKey] == true
      );
    }

    function isProtectedAdminTarget(uid) {
      return uid in ['fxKvKnbnksPqZy07rQjTzxIKzzP2', 'D6Z812za9ZNUW0kAt7SaFD3a9UN2'];
    }

    function isAdminOrMod() {
      return isSuperAdmin() || isActiveModerator();
    }

    function areContactsAccepted(uidA, uidB) {
      let idForward = uidA + '_' + uidB;
      let idReverse = uidB + '_' + uidA;
      return (
        (exists(/databases/$(database)/documents/contact_requests/$(idForward)) &&
         get(/databases/$(database)/documents/contact_requests/$(idForward)).data.status == 'ACCEPTED') ||
        (exists(/databases/$(database)/documents/contact_requests/$(idReverse)) &&
         get(/databases/$(database)/documents/contact_requests/$(idReverse)).data.status == 'ACCEPTED')
      );
    }

    // Spec §10.3 — server-side ban enforcement.
    // A ban used to be client-only: a banned user with a modified client (or raw API
    // access) could keep reading/writing everything. This helper makes the ban bite in
    // rules for the social surfaces (chats/messages/groups/stories/calls below).
    // Safety properties:
    //  - Field or user doc absent  => NOT banned (legitimate users are never locked out
    //    by a missing field; older docs predate the ban fields).
    //  - isBanned == true and banExpiresAt == 0/absent => permanent ban.
    //  - Timed ban lifts automatically once banExpiresAt (epoch millis) has passed.
    //  - Super admins are exempt (the client already forbids banning protected admins;
    //    this keeps moderation working even if a doc were mis-flagged).
    //  - The users collection itself is NOT gated by this helper, so a banned user can
    //    still read their own doc and see their ban status/reason in the client.
    // Remaining limit (documented in FIXLOG_P2): rules cannot revoke an already-issued
    // Firebase Auth token or set custom claims — that needs a backend (Admin SDK /
    // Cloud Function), which this repo does not deploy for WESAL yet.
    function isCurrentlyBanned() {
      return isSignedIn() &&
        !isSuperAdmin() &&
        // Active moderators are exempt too (round-2 fix): the staff system already
        // forbids banning them in the client, and without this exemption a stale
        // isBanned flag on a moderator doc silently killed every moderated surface
        // (chats/calls) while their admin panel kept working.
        !isActiveModerator() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banExpiresAt', 0) == 0 ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banExpiresAt', 0) > request.time.toMillis()
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }

    function channelData(channelId) {
      return get(/databases/$(database)/documents/channels/$(channelId)).data;
    }

    function isChannelManager(channelId) {
      let data = channelData(channelId);
      return isSignedIn() && (
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.moderatorIds
      );
    }

    function canReadChannelPosts(channelId) {
      let data = channelData(channelId);
      return isSignedIn() && (
        data.isPublic == true ||
        data.ownerUid == request.auth.uid ||
        request.auth.uid in data.moderatorIds ||
        request.auth.uid in data.subscriberIds
      );
    }

    // Super Admin registry
    match /super_admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Delegated Moderators
    match /moderators/{modUid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canManageAdmins');
    }

    // Global Appearance & Welcome Configuration
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canCustomizeGlobalTheme') || hasModPermission('canBroadcastAnnouncements');
    }

    // Frame / icon library managed from the admin panel (read: everyone signed in, write: admins/authorized mods)
    match /frame_library/{frameId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasModPermission('canManageLibrary') || hasModPermission('canManageFramesAndNeon');
    }

    // Verification & Subscription Requests
    match /subscription_requests/{reqId} {
      allow read: if hasModPermission('canManageVerification') || hasModPermission('canManageFramesAndNeon') || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if hasModPermission('canManageVerification') || hasModPermission('canManageFramesAndNeon');
    }

    // Verification & Admin & Hidden Audit Logs
    match /verification_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /hidden_audit_logs/{logId} {
      allow read: if isAdminOrMod();
      allow create: if isAdminOrMod() && request.resource.data.adminUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /official_announcements/{annId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || hasModPermission('canBroadcastAnnouncements');
    }

    match /banned_identifiers/{idHash} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasModPermission('canManageUsersModeration');
    }

    match /wesal_id_index/{numId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || hasModPermission('canManageUsersModeration') || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /phone_uniqueness/{pHash} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Round-2 §9.4/9.5: moderator writes to a user doc are FIELD-SCOPED. A write is
    // allowed only when EVERY changed key belongs to the field set of at least one
    // permission the moderator actually holds. The sets mirror exactly what the
    // client moderator flows write (UserRepositoryImpl: verification grant/revoke,
    // setAccountFrame/setAccountIcon/setAccountNeonStyle/setAccountNameplateColor,
    // banUser/warnUser/setAccountHiddenFromSearch/adminDeleteUser soft path, and
    // the setGlobalCustomerDefaults batch for theme-delegated moderators).
    // Previously ANY active moderator could rewrite ANY field of any
    // non-protected user document.
    function moderatorUserUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        (hasModPermission('canManageVerification') && changed.hasOnly([
          'isVerified', 'verifiedByUid', 'verifiedAt', 'verificationNote',
          'verificationType', 'verificationGlowColor', 'verificationGlowEnabled',
          'verificationGlowIntensity', 'verificationExpiresAt'
        ])) ||
        ((hasModPermission('canManageFramesAndNeon') || hasModPermission('canCustomizeGlobalTheme')) && changed.hasOnly([
          'frameId', 'frameUrl', 'frameExpiresAt', 'grantedFrameIds',
          'iconId', 'iconUrl',
          'neonEnabled', 'neonColor', 'neonGlowIntensity', 'nameplateColor'
        ])) ||
        (hasModPermission('canManageUsersModeration') && changed.hasOnly([
          'isBanned', 'banType', 'banReason', 'banExpiresAt', 'warningsCount',
          'hiddenFromSearch', 'hideFromSearchReason', 'hiddenAt', 'hiddenByUid',
          'deletedAt', 'deletedPermanent', 'isOnline'
        ]))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        !('isVerified' in request.resource.data && request.resource.data.isVerified == true) &&
        !('verifiedByUid' in request.resource.data && request.resource.data.verifiedByUid != '') &&
        !('deletedPermanent' in request.resource.data && request.resource.data.deletedPermanent == true) &&
        !('isBanned' in request.resource.data && request.resource.data.isBanned == true);
      allow update: if (
        isOwner(userId) &&
        (
          isSuperAdmin() ||
          (
            // The owner may not touch any admin-managed field. grantedFrameIds is
            // protected outright: only admin/mod grant flows may extend it.
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isVerified',
              'verifiedByUid',
              'verifiedAt',
              'verificationNote',
              'verificationType',
              'verificationGlowColor',
              'verificationGlowEnabled',
              'verificationGlowIntensity',
              'verificationExpiresAt',
              'frameUrl',
              'neonEnabled',
              'neonColor',
              'neonGlowIntensity',
              'adminPermissions',
              'isBanned',
              'banType',
              'banReason',
              'banExpiresAt',
              'warningsCount',
              'hiddenFromSearch',
              'hideFromSearchReason',
              'hiddenAt',
              'hiddenByUid',
              'grantedFrameIds'
            ]) &&
            // Frame self-pick carve-out (round 2): frameId/frameExpiresAt are NOT
            // in the protected list above; instead the owner may change them ONLY
            // to clear the frame, or to (re)apply a frame an admin granted them
            // (present in the doc's grantedFrameIds), or to keep the frame already
            // worn (legacy grants predate the list). Any other frame stays
            // admin-only, exactly like the client-side setOwnFrame() check.
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['frameId', 'frameExpiresAt']) ||
              request.resource.data.get('frameId', '') == '' ||
              request.resource.data.get('frameId', '') in resource.data.get('grantedFrameIds', []) ||
              request.resource.data.get('frameId', '') == resource.data.get('frameId', '') ||
              // The built-in all-customers default frame id: it is BY DESIGN the
              // frame every customer may wear (and the client reader's fallback
              // when the config doc was never written), so wearing it is never
              // a self-grant of a restricted frame.
              request.resource.data.get('frameId', '') == 'all_customers' ||
              // Review fix (round-2 pass 1): completeUserProfile() stamps the
              // admin-configured GLOBAL default frame into the same owner update
              // when the worn frame is blank. That default is neither granted
              // nor previously worn, so without this arm the whole profile
              // update was denied for blank-frame users. The arm only ever
              // allows the exact configured default (never an arbitrary frame)
              // and only while the global toggle is enabled in the config doc
              // the admin panel writes.
              (
                exists(/databases/$(database)/documents/system_config/global_appearance) &&
                get(/databases/$(database)/documents/system_config/global_appearance).data.get('globalCustomerFrameEnabled', false) == true &&
                (
                  request.resource.data.get('frameId', '') == get(/databases/$(database)/documents/system_config/global_appearance).data.get('defaultCustomerFrameId', '') ||
                  request.resource.data.get('frameId', '') == get(/databases/$(database)/documents/system_config/global_appearance).data.get('defaultFrameId', '')
                )
              )
            )
          )
        )
      ) || (
        isSuperAdmin()
      ) || (
        !isProtectedAdminTarget(userId) &&
        isActiveModerator() &&
        moderatorUserUpdateAllowed()
      );
      allow delete: if isSuperAdmin() && !isProtectedAdminTarget(userId);

      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /private/{docId} {
        allow read, write, delete: if isOwner(userId) || isSuperAdmin() || hasModPermission('canInspectPrivateData');
      }
    }

    // Deleted-account tombstones (spec §10.2): deleteAccountPermanently() writes one
    // doc per permanently deleted account (uid, numericId, publicId, deletedBy,
    // deletedAt, reason) so a deletion stays auditable after the user doc is gone.
    // The client write happens in the deleting admin's auth context (super admin —
    // the repository flow is super-admin-only), so create mirrors that; moderators
    // with user-moderation permission may also create/read for their flows.
    // Tombstones are immutable for everyone except the super admin.
    match /deleted_accounts/{docId} {
      allow read: if isSuperAdmin() || hasModPermission('canManageUsersModeration');
      allow create: if isSuperAdmin() || hasModPermission('canManageUsersModeration');
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Contact Requests & Friendship Gating
    match /contact_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid &&
        request.resource.data.status == 'PENDING';
      allow update: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }

    // Chats & E2EE Messages (direct chat creation requires ACCEPTED contact request; official WESAL & support chats allowed)
    match /chats/{chatId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && (
        request.auth.uid in resource.data.participantIds ||
        chatId == ('wesal_official_' + request.auth.uid) ||
        isAdminOrMod()
      );
      allow create: if isSignedIn() && !isCurrentlyBanned() && (
        (
          chatId == ('wesal_official_' + request.auth.uid) &&
          request.resource.data.isOfficialWesalChat == true &&
          request.auth.uid in request.resource.data.participantIds
        ) ||
        isAdminOrMod() ||
        (
          request.auth.uid in request.resource.data.participantIds && (
            request.resource.data.isGroup == true ||
            request.resource.data.isSupportChat == true ||
            (
              request.resource.data.participantIds.size() == 2 &&
              areContactsAccepted(
                request.resource.data.participantIds[0],
                request.resource.data.participantIds[1]
              )
            )
          )
        )
      );
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        request.auth.uid in resource.data.participantIds ||
        chatId == ('wesal_official_' + request.auth.uid) ||
        isAdminOrMod()
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if !isCurrentlyBanned() && (isChatParticipant(chatId) ||
          chatId == ('wesal_official_' + request.auth.uid) ||
          isAdminOrMod());
        allow create: if isSignedIn() && !isCurrentlyBanned() && (
          (isChatParticipant(chatId) && request.resource.data.senderId == request.auth.uid) ||
          (
            request.resource.data.senderId in ['WESAL_SYSTEM', 'wesal_system'] &&
            chatId.matches('wesal_official_.*') &&
            (chatId == ('wesal_official_' + request.auth.uid) || isAdminOrMod())
          )
        );
        allow update: if !isCurrentlyBanned() && isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedForUsers'])
        );
        allow delete: if isSuperAdmin();
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.adminIds &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if !isCurrentlyBanned() && (isGroupAdmin(groupId) || (
        isSignedIn() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'adminIds']) &&
        resource.data.memberIds.removeAll([request.auth.uid]) == request.resource.data.memberIds &&
        resource.data.adminIds.removeAll([request.auth.uid]) == request.resource.data.adminIds
      ));
      allow delete: if false;
    }

    // Broadcast Channels (Public & Private)
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.subscriberIds;
      allow update: if isAdminOrMod() || (
        isSignedIn() && (
          (
            (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.moderatorIds) &&
            request.resource.data.ownerUid == resource.data.ownerUid
          ) || (
            resource.data.isPublic == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberIds', 'subscribersCount'])
          ) || (
            request.auth.uid in resource.data.subscriberIds &&
            request.auth.uid != resource.data.ownerUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberIds', 'moderatorIds', 'subscribersCount'])
          )
        )
      );
      allow delete: if isAdminOrMod() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /posts/{postId} {
        allow read: if canReadChannelPosts(channelId);
        allow create: if isChannelManager(channelId) &&
          request.resource.data.authorUid == request.auth.uid;
        allow update: if isChannelManager(channelId) || (
          canReadChannelPosts(channelId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts', 'userReactions', 'commentsCount'])
        );
        allow delete: if isChannelManager(channelId);

        match /comments/{commentId} {
          allow read: if canReadChannelPosts(channelId);
          allow create: if canReadChannelPosts(channelId) &&
            request.resource.data.authorUid == request.auth.uid;
          allow delete: if isChannelManager(channelId) || (
            isSignedIn() && resource.data.authorUid == request.auth.uid
          );
          allow update: if false;
        }
      }

      match /join_requests/{requestId} {
        allow read: if isChannelManager(channelId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'PENDING';
        allow update: if isChannelManager(channelId);
        allow delete: if isChannelManager(channelId) || (
          isSignedIn() && resource.data.requesterUid == request.auth.uid
        );
      }
    }

    // Stories (24h TTL enforced in query & client)
    match /stories/{storyId} {
      allow read: if isSignedIn() && !isCurrentlyBanned();
      allow create: if isSignedIn() && !isCurrentlyBanned() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && !isCurrentlyBanned() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds'])
      );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.auth.uid == viewerId &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.ownerUid != request.auth.uid &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // WebRTC Calls Signaling
    match /calls/{callId} {
      allow read: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && !isCurrentlyBanned() &&
        request.resource.data.callerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && !isCurrentlyBanned() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /candidates/{candidateId} {
        allow read, create: if isSignedIn() && !isCurrentlyBanned() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }

    // Abuse Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update: if isSuperAdmin() || hasModPermission('canManageReports');
      allow delete: if false;
    }

    // Contact Label Lists
    match /contact_lists/{listId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Events & RSVPs
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids'])
      );
      allow delete: if isAdminOrMod() || (isSignedIn() && resource.data.creatorUid == request.auth.uid);
    }

    // Scheduled Calls
    match /scheduled_calls/{scheduleId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      allow update, delete: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.participants
      );
    }

    // Support Tickets & Replies
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdminOrMod());
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAdminOrMod() || (
        isSignedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.userUid == resource.data.userUid
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isAdminOrMod() ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          (
            isAdminOrMod() ||
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userUid == request.auth.uid
          );
        allow update, delete: if isSuperAdmin();
      }
    }

    // Broadcast Lists (distinct from Groups; sender-only)
    match /broadcast_lists/{listId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
