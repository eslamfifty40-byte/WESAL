# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WESAL Native APK Distribution & Android App Links
# GitHub repository slug hosting official WESAL.apk Releases (e.g. "eslamfifty40/wesal-messenger")
WESAL_GITHUB_REPO=""

# Optional explicit direct APK download URL override (defaults to GitHub latest release WESAL.apk when WESAL_GITHUB_REPO is set)
WESAL_APK_DOWNLOAD_URL=""

# Comma-separated SHA-256 certificate fingerprints (colon-separated uppercase hex) for /.well-known/assetlinks.json
# Debug keystore included below only for debug verification; add Release keystore SHA-256 in production.
WESAL_ANDROID_SHA256_FINGERPRINTS="D5:96:80:F8:72:2A:AE:9B:C3:C7:44:A5:F5:B4:A9:57:61:E0:08:C0:02:05:F7:EA:BA:79:4B:D8:D9:27:DC:0D"
