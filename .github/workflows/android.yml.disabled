name: Build APK
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
      - run: npm install --legacy-peer-deps --fetch-retries=5 --fetch-retry-mintimeout=20000
      - run: npm i @capacitor/core @capacitor/android --legacy-peer-deps
      - run: npm i -D @capacitor/cli @capacitor/assets --legacy-peer-deps
      - run: npm run build
      - run: rm -rf android capacitor.config.*
      - run: npx cap init 'وصال' com.eslam.wesal --web-dir=dist
      - run: |
          cat > capacitor.config.json <<'JSON'
          {"appId":"com.eslam.wesal","appName":"وصال","webDir":"dist","plugins":{"SplashScreen":{"launchShowDuration":0,"launchAutoHide":true,"backgroundColor":"#000000"}},"android":{"allowMixedContent":true}}
          JSON
      - run: npx cap add android
      - run: sh patch-android.sh
      - run: mkdir -p assets && cp iconWESAL.png assets/icon-only.png && cp iconWESAL.png assets/icon-foreground.png && cp iconWESAL.png assets/splash.png && cp iconWESAL.png assets/splash-dark.png
      - run: npx capacitor-assets generate --android --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#ffffff' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'
      - run: |
          F=android/app/src/main/res/values/styles.xml
          sed -i 's|</style>|<item name="android:windowSplashScreenAnimationDuration">0</item></style>|' $F
          sed -i 's|<item name="android:background">[^<]*</item>||' $F
      - run: npx cap sync android
      - run: pip install pillow
      - run: python3 fix_icon.py
      - run: python3 fix_perm.py
      - run: python3 pad_icon.py
      - run: |
          for d in mdpi hdpi xhdpi xxhdpi xxxhdpi; do
            [ -f android/app/src/main/res/mipmap-$d/ic_launcher_background.png ] || cp android/app/src/main/res/mipmap-$d/ic_launcher.png android/app/src/main/res/mipmap-$d/ic_launcher_background.png
          done
      - run: cd android && chmod +x gradlew && ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: WESAL-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
