{
  "name": "sabq-ai-functions",
  "private": true,
  "scripts": {
    "sync-src": "node scripts/sync-sources.mjs",
    "build": "node scripts/sync-sources.mjs && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^3.3.0",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^6.3.2",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.2"
  }
}
